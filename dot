#!/bin/sh
# dotfiles のリンクを管理する（中身は src/cli.ts）。使い方: ./dot --help
set -e
bun=$(command -v bun || true)
[ -z "$bun" ] && [ -x "$HOME/.bun/bin/bun" ] && bun="$HOME/.bun/bin/bun"
if [ -z "$bun" ]; then
	echo "bun が必要です: curl -fsSL https://bun.sh/install | bash" >&2
	exit 1
fi
exec "$bun" "$(dirname "$0")/src/cli.ts" "$@"
